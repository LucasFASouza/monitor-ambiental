# Dashboard: serve as APIs e a página na rede local.
#
#   sudo cp deploy/monitor-dashboard.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now monitor-dashboard

[Unit]
Description=Monitor Ambiental - dashboard Flask
After=network.target

[Service]
Type=simple
User=piuser
WorkingDirectory=/home/piuser/monitor-ambiental
ExecStart=/home/piuser/monitor-ambiental/.venv/bin/python app.py
Restart=always
RestartSec=10

Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
