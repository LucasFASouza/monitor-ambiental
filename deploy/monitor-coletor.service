# Coletor: lê o DHT11 e grava no SQLite.
#
#   sudo cp deploy/monitor-coletor.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now monitor-coletor
#   journalctl -u monitor-coletor -f

[Unit]
Description=Monitor Ambiental - coletor do DHT11
After=network.target

[Service]
Type=simple
User=piuser
WorkingDirectory=/home/piuser/monitor-ambiental
ExecStart=/home/piuser/monitor-ambiental/.venv/bin/python collector.py
Restart=always
RestartSec=10

# O journal já carimba a hora de cada linha.
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
